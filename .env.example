APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# PRODUCTION e: LOG_STACK=daily ar LOG_LEVEL=error korben.
# `single` mane sob log ek file e joma hoy — file GB te gele protita write slow
# hoye jay (append e exclusive lock lage). `daily` protidin notun file kore ar
# 14 din por purono gulo nije muche fele.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cd_class
DB_USERNAME=root
DB_PASSWORD=

# ⚠️ SESSION_DRIVER `database` theke poriborton korben NA — jotokhon na
# EnsureSingleStudentSession / AllowAdminOrStudent / studentLoginSubmit o
# poriborton kora hoy. Oi tinta jayga `sessions` DB table e SIDHA query kore
# ("ei account ki onno device e logged in?"). Driver file/redis kore dile oi
# query kokhono kichu pabe na, ar single-device check chupchap kaj kora bondho
# kore debe — kono error dekhabe na.
# Redis e jete hole age oi tinta jayga cache/Redis diye likhte hobe.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis install kora thakle CACHE_STORE=redis korle MySQL er upor chap kome.
# (SESSION_DRIVER er moto ekhane kono code nirbhorshilota nei — nirapode bodlano jay.)
CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Purono test data auto-cleanup (hexas:cleanup-old-test-data)
# ---------------------------------------------------------------------------
# Koto month er listening/reading/writing data rakha hobe. Er cheye purono row
# protidin raat 3:30 e muche jabe. ⚠️ Muche gele oi somoy er result / band score
# / PDF ar dekha jabe na — purono result lagle ei value baran.
TEST_DATA_RETENTION_MONTHS=2

# false kore dile scheduler kichu delete korbe na (--dry-run tobu kaj korbe).
TEST_DATA_CLEANUP_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

